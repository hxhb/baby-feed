generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  password        String
  role            String   @default("USER")
  passwordVersion Int      @default(0)
  activeBabyId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  babies          Baby[]
  feedingRecords  FeedingRecord[]
  healthRecords   HealthRecord[]
  apiKeys          ApiKey[]
  memos            Memo[]
  webhookEndpoints WebhookEndpoint[]
  reminderRules    ReminderRule[]
  reminderSettings String?
  quickRecordSettings String?
}

model SiteSettings {
  id    String @id @default("singleton")
  key   String @unique
  value String
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String                          // 用户自定义名称，如 "iOS快捷指令"
  prefix      String                          // Key 前缀，如 "bfk_a1b2"，用于识别
  keyHash     String    @unique               // SHA-256 哈希值，不存储明文
  userId      String                          // 所属用户
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?                       // 最后使用时间
  expiresAt   DateTime?                       // 过期时间（可选）
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model Baby {
  id        String   @id @default(cuid())
  name      String
  birthDate DateTime
  gender    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  user      User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  feedingRecords FeedingRecord[]
  healthRecords HealthRecord[]
  memos          Memo[]
  reminderRules  ReminderRule[]

  @@index([createdBy])
}

model FeedingRecord {
  id                  String    @id @default(cuid())
  babyId              String
  type                String
  leftBreastDuration  Int?
  rightBreastDuration Int?
  breastMilkAmount    Float?
  formulaAmount       Float?
  solidFoodName       String?
  solidFoodAmount     String?
  adGiven             Boolean?
  startTime           DateTime
  endTime             DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String
  baby                Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy, babyId, startTime])
  @@index([babyId, startTime])
}

model HealthRecord {
  id                String    @id @default(cuid())
  babyId            String
  type              String
  weight            Float?
  height            Float?
  temperature       Float?
  medicationName    String?
  medicationDose    String?
  vaccineName       String?
  vaccineManufacturer String?
  vaccineDoseNumber Int?
  vaccineTotalDoses Int?
  diaperType        String?
  diaperStatus      String?
  adGiven           Boolean?
  vitaminDGiven     Boolean?
  customName        String?
  sleepStartTime    DateTime?
  sleepEndTime      DateTime?
  sleepQuality      String?
  recordedAt        DateTime
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String
  baby              Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy, babyId, recordedAt])
  @@index([babyId, type, recordedAt])
}

model Memo {
  id          String    @id @default(cuid())
  babyId      String
  title       String                          // 备忘标题
  content     String?                         // 备忘详细内容（可选）
  scheduledAt DateTime                        // 备忘时间（什么时候该做这件事）
  completed   Boolean   @default(false)       // 是否已处理
  completedAt DateTime?                       // 标记完成的时间
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String
  baby        Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([createdBy, babyId, scheduledAt])
  @@index([babyId, completed, scheduledAt])
}

model WebhookEndpoint {
  id          String    @id @default(cuid())
  userId      String
  url         String
  description String?
  // Webhook event types this endpoint subscribes to (JSON array of strings)
  // e.g. ["feeding.created", "feeding.updated", "health.created", "user.deleted"]
  events      String    @default("[]")
  
  // Signature secret for HMAC-SHA256 verification
  secret      String
  
  // Active/inactive toggle
  active      Boolean   @default(true)
  
  // Retry configuration
  maxRetries  Int       @default(5)
  retryDelay  Int       @default(60) // seconds
  
  // Metadata
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastTriedAt DateTime?
  
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([active])
}

model ReminderRule {
  id              String    @id @default(cuid())
  userId          String
  babyId          String

  name            String
  enabled         Boolean   @default(true)

  triggerType     String
  triggerConfig   String
  activeSchedule  String?

  advanceMinutes  Int       @default(0)

  notifyTitle     String
  notifyBody      String?

  startsAt        DateTime?
  expiresAt       DateTime?

  lastFiredAt     DateTime?
  nextCheckAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  baby            Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([babyId])
  @@index([enabled, nextCheckAt])
}
