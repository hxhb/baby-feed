generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  babies    Baby[]
  feedingRecords FeedingRecord[]
  healthRecords HealthRecord[]
  apiKeys   ApiKey[]
}

model SiteSettings {
  id    String @id @default("singleton")
  key   String @unique
  value String
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String                          // 用户自定义名称，如 "iOS快捷指令"
  prefix      String                          // Key 前缀，如 "bfk_a1b2"，用于识别
  keyHash     String    @unique               // SHA-256 哈希值，不存储明文
  userId      String                          // 所属用户
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?                       // 最后使用时间
  expiresAt   DateTime?                       // 过期时间（可选）
  createdAt   DateTime  @default(now())
}

model Baby {
  id        String   @id @default(cuid())
  name      String
  birthDate DateTime
  gender    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String
  user      User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  feedingRecords FeedingRecord[]
  healthRecords HealthRecord[]
}

model FeedingRecord {
  id                  String    @id @default(cuid())
  babyId              String
  type                String
  leftBreastDuration  Int?
  rightBreastDuration Int?
  breastMilkAmount    Float?
  formulaAmount       Float?
  adGiven             Boolean?
  startTime           DateTime
  endTime             DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String
  baby                Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user                User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}

model HealthRecord {
  id              String    @id @default(cuid())
  babyId          String
  type            String
  weight          Float?
  height          Float?
  temperature     Float?
  medicationName  String?
  medicationDose  String?
  vaccineName     String?
  diaperType      String?
  diaperStatus    String?
  adGiven         Boolean?
  recordedAt      DateTime
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String
  baby            Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
}
